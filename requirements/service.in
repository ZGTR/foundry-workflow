# Third-party runtime dependencies for foundry-workflow's container image.
# shepherd-contracts and shepherd_workflow_service themselves are NOT pip-installed here -- the
# Dockerfile COPYs their source directly (see Dockerfile's comment) so this
# lockfile only has to pin and hash packages that actually come from PyPI.
fastapi>=0.115
uvicorn>=0.30
pydantic>=2.7
boto3>=1.34
# JWT verification for the signature-verifying PrincipalAuth adapter.
# `[crypto]` pulls `cryptography`, which is required for RS256/ES256 -- a Cognito
# JWKS is RSA, and without it PyJWT can only do HMAC, which is the wrong shape
# entirely for a token you did not issue.
pyjwt[crypto]>=2.9

# MySQL 8 driver. In the IMAGE, not just the dev extra: every deployed service in
# this estate persists to MySQL 8.0.46 (a local `mysql` Compose service, and a
# managed RDS instance in production). Pure Python, so it adds
# no build toolchain to the container.
pymysql>=1.1

# SQLAlchemy Core (no ORM) -- `shepherd_workflow.sql.schema` builds the ledger's
# five tables on a MetaData and `sql.repository` issues the version-conditional
# UPDATE. In the IMAGE rather than a dev extra: the workflow ledger is the
# service's entire purpose and there is no in-memory deployment mode.
sqlalchemy>=2.0
